    )
  }
}

struct IntentLaneShortcuts: AppShortcutsProvider {
  static var appShortcuts: [AppShortcut] {
      AppShortcut(intent: OpenIdea(), phrases: [
        "Open an idea in \\(.applicationName)"
      ], shortTitle: LocalizedStringResource("Open an idea", table: "IntentLane"), systemImageName: "sparkles")
  }
}
