struct CreateIdea: AppIntent {
  static let title: LocalizedStringResource = LocalizedStringResource("Create an idea", table: "IntentLane")

  @Parameter(title: LocalizedStringResource("title", table: "IntentLane"))
  var title: String

  @Parameter(title: LocalizedStringResource("effort", table: "IntentLane"))
  var effort: Int

  @Parameter(title: LocalizedStringResource("ratio", table: "IntentLane"))
  var ratio: Double

  @Parameter(title: LocalizedStringResource("pinned", table: "IntentLane"))
  var pinned: Bool

  @Parameter(title: LocalizedStringResource("due", table: "IntentLane"))
  var due: DateComponents

  @Parameter(title: LocalizedStringResource("at", table: "IntentLane"))
  var at: Date

  @Parameter(title: LocalizedStringResource("priority", table: "IntentLane"))
  var priority: IntentLaneCreateIdeaPriority

  func perform() async throws -> some IntentResult & ProvidesDialog & ShowsSnippetView & OpensIntent {
    let url = IntentLaneRoute.make(scheme: "example", path: "/ideas/new", query: ["at": at.ISO8601Format(), "due": String(format: "%04d-%02d-%02d", due.year ?? 0, due.month ?? 0, due.day ?? 0), "effort": String(effort), "pinned": pinned ? "true" : "false", "priority": priority.rawValue, "ratio": String(ratio), "title": title])
    return .result(
      opensIntent: OpenURLIntent(url),
      dialog: IntentDialog(LocalizedStringResource("Your idea is ready", table: "IntentLane")),
      view: IntentLaneSnippetView(title: LocalizedStringResource("Create an idea", table: "IntentLane"), fields: [(LocalizedStringResource("title", table: "IntentLane"), title), (LocalizedStringResource("effort", table: "IntentLane"), String(effort)), (LocalizedStringResource("ratio", table: "IntentLane"), String(ratio)), (LocalizedStringResource("pinned", table: "IntentLane"), pinned ? "true" : "false"), (LocalizedStringResource("due", table: "IntentLane"), String(format: "%04d-%02d-%02d", due.year ?? 0, due.month ?? 0, due.day ?? 0)), (LocalizedStringResource("at", table: "IntentLane"), at.ISO8601Format()), (LocalizedStringResource("priority", table: "IntentLane"), priority.rawValue)])
    )
  }
}

