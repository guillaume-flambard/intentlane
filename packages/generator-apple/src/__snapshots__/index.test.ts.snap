struct IntentLaneNoteEntity: AppEntity {
  static var typeDisplayRepresentation: TypeDisplayRepresentation {
    TypeDisplayRepresentation(name: LocalizedStringResource("Note", table: "IntentLane"))
  }

  static let defaultQuery = IntentLaneNoteQuery()

  let id: String
  let title: String
  let status: String?

  var displayRepresentation: DisplayRepresentation {
    DisplayRepresentation(
      title: LocalizedStringResource(stringLiteral: title),
      subtitle: status.map { LocalizedStringResource(stringLiteral: $0) }
    )
  }
}

protocol IntentLaneNoteResolver: Sendable {
  func noteEntities(for identifiers: [String]) async throws -> [IntentLaneNoteEntity]
  func suggestedNoteEntities() async throws -> [IntentLaneNoteEntity]
}

struct IntentLaneNoteQuery: EntityQuery {
  func entities(for identifiers: [String]) async throws -> [IntentLaneNoteEntity] {
    guard let resolver = await IntentLaneEntityResolvers.note else { return [] }
    return try await resolver.noteEntities(for: identifiers)
  }

  func suggestedEntities() async throws -> [IntentLaneNoteEntity] {
    guard let resolver = await IntentLaneEntityResolvers.note else { return [] }
    return try await resolver.suggestedNoteEntities()
  }
}

@MainActor
enum IntentLaneEntityResolvers {
  static var note: (any IntentLaneNoteResolver)?
}

protocol ArchiveNoteHandler: Sendable {
  func perform(note: IntentLaneNoteEntity) async throws
}

protocol CreateNoteHandler: Sendable {
  func perform(title: String, pinned: Bool) async throws -> IntentLaneNoteEntity
}

enum IntentLaneHandlerError: Error {
  case missingHandler(String)
}

@MainActor
enum IntentLaneIntentHandlers {
  static var archive_note: (any ArchiveNoteHandler)?
  static var create_note: (any CreateNoteHandler)?
}

struct ArchiveNote: AppIntent {
  static let title: LocalizedStringResource = LocalizedStringResource("Archive a note", table: "IntentLane")

  @Parameter(title: LocalizedStringResource("note", table: "IntentLane"))
  var note: IntentLaneNoteEntity

  func perform() async throws -> some IntentResult & ProvidesDialog {
    guard let handler = await IntentLaneIntentHandlers.archive_note else {
      throw IntentLaneHandlerError.missingHandler("archive_note")
    }
    try await handler.perform(note: note)
    return .result(dialog: IntentDialog(LocalizedStringResource("Note archived", table: "IntentLane")))
  }
}

struct CreateNote: AppIntent {
  static let title: LocalizedStringResource = LocalizedStringResource("Create a note", table: "IntentLane")

  @Parameter(title: LocalizedStringResource("Note title", table: "IntentLane"))
  var title: String

  @Parameter(title: LocalizedStringResource("pinned", table: "IntentLane"))
  var pinned: Bool

  func perform() async throws -> some IntentResult & ProvidesDialog & ReturnsValue<IntentLaneNoteEntity> {
    guard let handler = await IntentLaneIntentHandlers.create_note else {
      throw IntentLaneHandlerError.missingHandler("create_note")
    }
    let value = try await handler.perform(title: title, pinned: pinned)
    return .result(value: value, dialog: IntentDialog(LocalizedStringResource("Note created", table: "IntentLane")))
  }
}
"
`;

