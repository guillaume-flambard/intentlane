"// Generated by IntentLane. Do not edit.
// Source schema: 0.1

import AppIntents
import Foundation
import SwiftUI

enum IntentLaneRoute {
  static func make(scheme: String, path: String, query: [String: String]) -> URL {
    var components = URLComponents()
    components.scheme = scheme
    components.path = path
    components.queryItems = query.sorted { $0.key < $1.key }.map { URLQueryItem(name: $0.key, value: $0.value) }
    return components.url ?? URL(string: "about:blank")!
  }
}

struct IntentLaneSnippetView: View {
  let title: LocalizedStringResource
  let fields: [(LocalizedStringResource, String)]

  var body: some View {
    VStack(alignment: .leading, spacing: 8) {
      Text(title).font(.headline)
      ForEach(fields.indices, id: \\.self) { index in
        HStack {
          Text(fields[index].0).foregroundStyle(.secondary)
          Spacer()
          Text(fields[index].1)
        }
      }
    }
    .padding()
  }
}

struct IntentLaneIdeaEntity: AppEntity {
  static var typeDisplayRepresentation: TypeDisplayRepresentation {
    TypeDisplayRepresentation(name: LocalizedStringResource("Idea", table: "IntentLane"))
  }

  static var defaultQuery = IntentLaneIdeaQuery()

  let id: String
  let title: String
  let status: String?

  var displayRepresentation: DisplayRepresentation {
    DisplayRepresentation(
      title: LocalizedStringResource(stringLiteral: title),
      subtitle: status.map { LocalizedStringResource(stringLiteral: $0) }
    )
  }
}

protocol IntentLaneIdeaResolver {
  func ideaEntities(for identifiers: [String]) async throws -> [IntentLaneIdeaEntity]
  func suggestedIdeaEntities() async throws -> [IntentLaneIdeaEntity]
}

struct IntentLaneIdeaQuery: EntityQuery {
  func entities(for identifiers: [String]) async throws -> [IntentLaneIdeaEntity] {
    guard let resolver = await IntentLaneEntityResolvers.idea else { return [] }
    return try await resolver.ideaEntities(for: identifiers)
  }

  func suggestedEntities() async throws -> [IntentLaneIdeaEntity] {
    guard let resolver = await IntentLaneEntityResolvers.idea else { return [] }
    return try await resolver.suggestedIdeaEntities()
  }
}

struct IntentLaneTagEntity: AppEntity {
  static var typeDisplayRepresentation: TypeDisplayRepresentation {
    TypeDisplayRepresentation(name: LocalizedStringResource("Tag", table: "IntentLane"))
  }

  static var defaultQuery = IntentLaneTagQuery()

  let id: String
  let name: String

  var displayRepresentation: DisplayRepresentation {
    DisplayRepresentation(
      title: LocalizedStringResource(stringLiteral: name)
    )
  }
}

protocol IntentLaneTagResolver {
  func tagEntities(for identifiers: [String]) async throws -> [IntentLaneTagEntity]
  func suggestedTagEntities() async throws -> [IntentLaneTagEntity]
}

struct IntentLaneTagQuery: EntityQuery {
  func entities(for identifiers: [String]) async throws -> [IntentLaneTagEntity] {
    guard let resolver = await IntentLaneEntityResolvers.tag else { return [] }
    return try await resolver.tagEntities(for: identifiers)
  }

  func suggestedEntities() async throws -> [IntentLaneTagEntity] {
    guard let resolver = await IntentLaneEntityResolvers.tag else { return [] }
    return try await resolver.suggestedTagEntities()
  }
}

@MainActor
enum IntentLaneEntityResolvers {
  static var idea: (any IntentLaneIdeaResolver)?
  static var tag: (any IntentLaneTagResolver)?
}

struct OpenIdea: AppIntent {
  static let title: LocalizedStringResource = LocalizedStringResource("Open an idea", table: "IntentLane")

  @Parameter(title: LocalizedStringResource("idea", table: "IntentLane"))
  var idea: IntentLaneIdeaEntity

  @Parameter(title: LocalizedStringResource("tag", table: "IntentLane"))
  var tag: IntentLaneTagEntity

  func perform() async throws -> some IntentResult & ProvidesDialog & ShowsSnippetView & OpensIntent {
    let url = IntentLaneRoute.make(scheme: "example", path: "/ideas", query: ["idea": idea.id])
    return .result(
      opensIntent: OpenURLIntent(url),
      dialog: IntentDialog(LocalizedStringResource("Open an idea", table: "IntentLane")),
      view: IntentLaneSnippetView(title: LocalizedStringResource("Open an idea", table: "IntentLane"), fields: [(LocalizedStringResource("idea", table: "IntentLane"), idea.id), (LocalizedStringResource("tag", table: "IntentLane"), tag.id)])
    )
  }
}

struct IntentLaneShortcuts: AppShortcutsProvider {
  static var appShortcuts: [AppShortcut] {
      AppShortcut(intent: OpenIdea(), phrases: [
        "Open an idea in \\(.applicationName)"
      ], shortTitle: LocalizedStringResource("Open an idea", table: "IntentLane"), systemImageName: "sparkles")
  }
}
"
`;

