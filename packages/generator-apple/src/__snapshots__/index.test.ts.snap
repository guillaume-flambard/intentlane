"// Generated by IntentLane. Do not edit.
// Source schema: 0.1

import AppIntents
import Foundation
import SwiftUI

enum IntentLaneRoute {
  static func make(scheme: String, path: String, query: [String: String]) -> URL {
    var components = URLComponents()
    components.scheme = scheme
    components.path = path
    if !query.isEmpty {
      components.queryItems = query.sorted { $0.key < $1.key }.map { URLQueryItem(name: $0.key, value: $0.value) }
    }
    return components.url ?? URL(string: "about:blank")!
  }
}

struct IntentLaneSnippetView: View {
  let title: LocalizedStringResource
  let fields: [(LocalizedStringResource, String)]

  var body: some View {
    VStack(alignment: .leading, spacing: 8) {
      Text(title).font(.headline)
      ForEach(fields.indices, id: \\.self) { index in
        HStack {
          Text(fields[index].0).foregroundStyle(.secondary)
          Spacer()
          Text(fields[index].1)
        }
      }
    }
    .padding()
  }
}

@AppEntity(schema: .audio.ambientSound)
struct IntentLaneSoundEntity: AppEntity {
  static let defaultQuery = IntentLaneSoundQuery()

  var id: String
  var title: String
  init(id: String, title: String) {
    self.id = id
    self.title = title
  }

  var displayRepresentation: DisplayRepresentation {
    DisplayRepresentation(
      title: LocalizedStringResource(stringLiteral: title)
    )
  }
}

protocol IntentLaneSoundResolver: Sendable {
  func soundEntities(for identifiers: [String]) async throws -> [IntentLaneSoundEntity]
  func suggestedSoundEntities() async throws -> [IntentLaneSoundEntity]
}

struct IntentLaneSoundQuery: EntityQuery {
  func entities(for identifiers: [String]) async throws -> [IntentLaneSoundEntity] {
    guard let resolver = await IntentLaneEntityResolvers.sound else { return [] }
    return try await resolver.soundEntities(for: identifiers)
  }

  func suggestedEntities() async throws -> [IntentLaneSoundEntity] {
    guard let resolver = await IntentLaneEntityResolvers.sound else { return [] }
    return try await resolver.suggestedSoundEntities()
  }
}

@MainActor
enum IntentLaneEntityResolvers {
  static var sound: (any IntentLaneSoundResolver)?
}

@AppIntent(schema: .camera.stopCapture)
struct StopCapture: AppIntent {
  static let title: LocalizedStringResource = LocalizedStringResource("Stop capture", table: "IntentLane")



  func perform() async throws -> some IntentResult & ProvidesDialog & ShowsSnippetView & OpensIntent {
    let intentLaneURL = IntentLaneRoute.make(scheme: "studio", path: "/stop", query: [:])
    return .result(
      opensIntent: OpenURLIntent(intentLaneURL),
      dialog: IntentDialog(LocalizedStringResource("Stop capture", table: "IntentLane")),
      view: IntentLaneSnippetView(title: LocalizedStringResource("Stop capture", table: "IntentLane"), fields: [])
    )
  }
}
"
`;

